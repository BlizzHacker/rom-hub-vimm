__pycache__/
.pytest_cache/
*.py[cod]
dist/

# EmulatorJS is a 297MB GPL-3.0 release. This repository is MIT, and vendoring
# a copy would both bloat every clone and mix the two licences in one tree.
# vault/fetch-emulatorjs.sh pulls it at deploy time instead.
emulatorjs/

# Generated by the cataloguer, not written by hand. The enriched catalogue is
# 14MB and changes on every scraper pass; catalog.json stays in the tree only
# as the empty template that documents the shape.
catalog-enriched.json
scraper-progress.json
*.log
source.tar

# Downloaded ROMs and proxied artwork.
cache/
art-cache/
